DATABASE_URL="postgresql://carshow:carshow@localhost:5432/carshow?schema=public"
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET="replace-me-with-a-long-random-secret"
NODE_ENV=development
VITE_API_URL="http://localhost:4000"
VITE_PUBLIC_BASE_PATH="/carshow"
VITE_PUBLIC_APP_URL="https://automationsolutions.ddns.net/carshow"

# --- Photo upload + moderation pipeline ---
# Drivers: local|s3 for storage, mock|rekognition for moderation.
STORAGE_DRIVER="local"
MODERATION_DRIVER="mock"
TEXT_MODERATION_DRIVER="mock"           # mock | comprehend | none
# TEXT_MODERATION_MIN_CONFIDENCE=0.5   # 0–1, default 0.5

# Local filesystem driver (dev): where photos are written + how APPROVED ones are served.
LOCAL_STORAGE_DIR="var/media"
MEDIA_PUBLIC_BASE_URL="http://localhost:4000"

# S3 + Rekognition drivers (prod) — from `terraform output` (see infra/README.md).
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# S3_BUCKET="carshow-photos-..."
# CDN_BASE_URL="https://dxxxxxxxx.cloudfront.net"
# MODERATION_MIN_CONFIDENCE="60"

# Upload limits (common to all drivers). 5 MB matches Rekognition's inline Bytes cap.
PHOTO_MAX_BYTES="5242880"
PHOTO_PER_VEHICLE_CAP="10"

# Planning Center Online OAuth (production staff login).
# Register the callback URI in the PCO developer console first.
# Dev: PLANNING_CENTER_CALLBACK_URL should be http://localhost:4000/auth/planning-center/callback
# Prod: https://{api-domain}/auth/planning-center/callback
# PLANNING_CENTER_CLIENT_ID="..."
# PLANNING_CENTER_CLIENT_SECRET="..."
# PLANNING_CENTER_CALLBACK_URL="http://localhost:4000/auth/planning-center/callback"
# ADMIN_WEB_URL="http://localhost:3000"
# JUDGE_WEB_URL="http://localhost:3002"
#
# PCO Services team whose member positions grant staff roles.
# Positions within that team must be named "Admin", "Judge", or "Registrar" exactly.
# Defaults to "Carshow Admin" if not set.
# PCO_TEAM_NAME="Carshow Admin"

# WebGuide credentials used by CSV importer to download source vehicle photos.
# Supports either WEBGUIDE_USERNAME/WEBGUIDE_PASSWORD or legacy
# WEBGUIDEUSERNAME/WEBGUIDEPASSWORD variable names.
# WEBGUIDE_BASE_URL="https://www.celebrationedmonton.com"
# WEBGUIDE_USERNAME="name@example.com"
# WEBGUIDE_PASSWORD="..."
