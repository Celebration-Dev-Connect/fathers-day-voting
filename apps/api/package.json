{
  "name": "@carshow/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace @carshow/db && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "npm run build --workspace @carshow/db && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build --workspace @carshow/db && node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "npm run build --workspace @carshow/db && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/client-sts": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@carshow/db": "file:../../packages/db",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "fastify": "^5.3.3",
    "sharp": "^0.34.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4"
  }
}
