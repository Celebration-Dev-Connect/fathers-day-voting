{
  "name": "@carshow/perf",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "perf": "tsx scripts/run-perf.ts",
    "perf:browse": "artillery run --output reports/browse.json artillery/browse.yml",
    "perf:vote": "artillery run --output reports/vote.json artillery/vote.yml",
    "perf:upload": "artillery run --output reports/upload.json artillery/upload.yml",
    "perf:report": "artillery report reports/browse.json reports/vote.json reports/upload.json"
  },
  "dependencies": {
    "@carshow/db": "file:../../packages/db"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "artillery": "^2.0.0",
    "form-data": "^4.0.0",
    "tsx": "^4.19.0"
  }
}
