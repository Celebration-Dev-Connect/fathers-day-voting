{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResolveInstance",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    },
    {
      "Sid": "SsmImageTagParam",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter"
      ],
      "Resource": "arn:aws:ssm:ca-central-1:123456789012:parameter/carshow/prod/*"
    },
    {
      "Sid": "SsmSendCommand",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:ca-central-1:123456789012:instance/*",
        "arn:aws:ssm:ca-central-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "SsmCommandStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
