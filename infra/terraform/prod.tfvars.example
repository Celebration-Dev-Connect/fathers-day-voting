# Copy to prod.tfvars and fill in values. Full-size, protected PRODUCTION stack.
# Deploy with the "prod" Terraform workspace:
#   ./infra/deploy.sh --env prod
#
# prod.tfvars is gitignored — never commit it.

region      = "ca-central-1"
project     = "carshow"
environment = "prod"
domain      = "carshow.celebrationedmonton.com"
db_username = "carshow"

# Route 53 hosted zone ID for the domain (auto-manages ACM validation + alias).
# Leave empty if celebrationedmonton.com DNS is managed outside this account —
# you'll then add the validation + alias records manually and the cert must be
# issued before CloudFront can build.
route53_zone_id = ""

# ── Full resources (event-day sizing) ──
# ecs_min_size=2 pre-warms 2 tasks before gates open (no cold-start lag at arrival surge).
# ecs_max_size=6 gives headroom for up to 10,000 attendees over 7 hours.
# db.t3.small avoids CPU-credit depletion under 7h sustained load (t3.micro would throttle).
ecs_cpu        = "1024"
ecs_memory     = "2048"
ecs_min_size   = 2
ecs_max_size   = 5
rds_instance_class    = "db.t3.medium"
rds_allocated_storage = 20
rds_backup_retention  = 1
db_connection_limit   = 20     # 2 tasks × 20 = 40 conns steady; 5 × 20 = 100 at max scale

# ── Production posture ──
# Planning Center OAuth (no local login), no auto-seed, and protected data
# (deletion protection + final snapshot block a casual `terraform destroy`).
enable_dev_login  = false
run_seed          = false
teardown_friendly = false

# Lock the API's CORS to the known web origin. The SPAs are same-origin behind
# CloudFront so this rarely matters, but pinning it is cheap defense in depth.
# If launching on the *.cloudfront.net URL (cloudfront_custom_domain=false),
# leave this empty until the custom domain is live.
cors_allowed_origins = "https://carshow.celebrationedmonton.com"

# Email subscribed to CloudWatch alarms (ALB 5xx, unhealthy tasks, RDS/ECS
# saturation, CloudFront 5xx). You must click the SNS confirmation email AWS
# sends after the first apply, or no alerts are delivered.
alert_email = ""

# Optional SMS number (E.164) for the same alarms. New accounts are in the SNS
# SMS sandbox: verify the number in the SNS console (Mobile → Text messaging →
# Sandbox) or request production access, or SMS won't deliver.
alert_sms = ""

# ── Planning Center OAuth (fill these in prod.tfvars, never here) ──
# pco_client_id     = ""
# pco_client_secret = ""
# pco_callback_url  = "https://carshow.celebrationedmonton.com/api/auth/planning-center/callback"
# pco_team_name     = "carshow"
# admin_web_url     = "https://carshow.celebrationedmonton.com/admin"
# judge_web_url     = "https://carshow.celebrationedmonton.com/judge"

# ── Launching without the custom domain yet? ──
# Uncomment to serve fully on the AWS *.cloudfront.net URL with no DNS/ACM
# dependency. Update pco_callback_url / *_web_url / cors_allowed_origins to that
# URL, and flip back once the domain's CNAME + ACM validation records are added.
# cloudfront_custom_domain = false

# Bootstrap order (handled automatically by ./infra/deploy.sh):
#   1. terraform apply -target=aws_ecr_repository.api
#   2. docker build + push to ECR with a commit SHA tag
#   3. terraform apply -var="image_tag=<sha>"
# Never use "latest" once the service is live.
image_tag = "latest"
