# Copy to terraform.tfvars and fill in values.
# terraform.tfvars, *.tfstate*, and .terraform/ are gitignored — never commit them.

region      = "ca-central-1"
project     = "carshow"
environment = "prod"
domain      = "carshow.celebrationedmonton.com"
db_username = "carshow"

# Bootstrap order:
#   1. terraform apply -target=aws_ecr_repository.api
#   2. docker build + push to ECR with a commit SHA tag
#   3. set app_runner_image_tag to that SHA
#   4. terraform apply (full stack)
#
# Never use "latest" once the service is live.
app_runner_image_tag = "latest"
