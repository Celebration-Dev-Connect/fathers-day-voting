# Copy to test.tfvars and adjust. Cheap, disposable, real-infra TEST stack.
# Deploy with the "test" Terraform workspace:
#   ./infra/deploy.sh --env test

region      = "ca-central-1"
project     = "carshow"
environment = "test"
domain      = "carshow.chasesspace.com"
db_username = "carshow"

# Set to your Route 53 hosted zone ID to auto-manage ACM validation + the alias
# record (single-apply). Leave empty ("") for externally-managed DNS.
route53_zone_id = ""

# ── Reduced resources (≤5 concurrent testers) ──
ecs_cpu               = "512"
ecs_memory            = "1024"
ecs_min_size          = 1
ecs_max_size          = 1
rds_instance_class    = "db.t3.micro"
rds_allocated_storage = 20
rds_backup_retention  = 0

# ── Test behavior ──
enable_dev_login  = true
run_seed          = true
teardown_friendly = true

image_tag = "latest"

# ── Planning Center OAuth ──
pco_client_id     = ""
pco_client_secret = ""
pco_api_app_id    = ""
pco_api_secret    = ""
pco_callback_url  = "https://carshow-test.chasesspace.com/api/auth/planning-center/callback"
pco_team_name     = "carshow"
admin_web_url     = "https://carshow-test.chasesspace.com/admin"
judge_web_url     = "https://carshow-test.chasesspace.com/judge"

# ── Email (SES SMTP) ──
# email_from_address  = "mail@celebrationedmonton.com"
# owner_portal_url    = "https://visit.fathersdaycarshow.ca/owner"
# email_smtp_username = ""   # sensitive — store in GitHub secrets, never commit
# email_smtp_password = ""   # sensitive — store in GitHub secrets, never commit
