generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  REGISTRAR
  JUDGE
}

enum VehicleStatus {
  DRAFT
  REGISTERED
  CHECKED_IN
}

enum RegistrationSource {
  ONSITE
  ONLINE_IMPORT
}

enum RegistrationImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum RegistrationImportItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  SKIPPED
  FAILED
}

enum QrCardStatus {
  PRINTED
  ASSIGNED
  REASSIGNED
  RETIRED
  REPRINTED
}

enum QrAuditAction {
  ASSIGNED
  REASSIGNED
  REPRINTED
  RETIRED
}

model Event {
  id                     String                   @id @default(cuid())
  name                   String
  eventDate              DateTime
  venueName              String
  venueAddress           String
  registrationOpen       Boolean                  @default(true)
  votingOpen             Boolean                  @default(false)
  publicPhotoUploadsOpen Boolean                  @default(true)
  peopleChoiceCutoff     DateTime?
  judgesVotingEnabled    Boolean                  @default(true)
  judgingOpen            Boolean                  @default(false)
  resultsPublished       Boolean                  @default(false)
  resultsPublishedAt     DateTime?
  resultsPublishedById   String?
  resultsSnapshot        Json?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  categories             Category[]
  vehicleEntries         VehicleEntry[]
  qrCards                QrCard[]
  peopleChoiceVotes      PeopleChoiceVote[]
  judgeCategoryPicks     JudgeCategoryPick[]
  winnerOverrides        CategoryWinnerOverride[]
  specialAwards          SpecialAward[]
  specialAwardVotes      SpecialAwardVote[]
  registrationImportJobs RegistrationImportJob[]
}

model PcoTeamRole {
  id           String    @id @default(cuid())
  pcoTeamId    String?
  pcoTeamName  String
  pcoServiceTypeName String?
  positionName String?
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([pcoTeamId])
}

model StaffUser {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  displayName            String
  role                   StaffRole
  planningCenterId       String?                  @unique
  pcoAccessToken         String?
  pcoRefreshToken        String?
  pcoTokenExpiresAt      DateTime?
  devLogin               Boolean                  @default(false)
  active                 Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  registrations          VehicleEntry[]           @relation("RegisteredBy")
  auditLogs              QrAssignmentAuditLog[]   @relation("QrAuditStaff")
  winnerOverrides        CategoryWinnerOverride[]
  registrationImportJobs RegistrationImportJob[]
  excludedPeopleChoiceVotes PeopleChoiceVote[]     @relation("PeopleChoiceVoteExcludedBy")
  excludedSpecialAwardVotes SpecialAwardVote[]     @relation("SpecialAwardVoteExcludedBy")
}

model Category {
  id                 String                   @id @default(cuid())
  eventId            String
  name               String
  slug               String
  active             Boolean                  @default(true)
  sortOrder          Int                      @default(0)
  ceremonyOrder      Int?
  importIdentifier   String?
  importYearMin      Int?
  importYearMax      Int?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  event              Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicleEntries     VehicleEntry[]
  judgeCategoryPicks JudgeCategoryPick[]
  winnerOverrides    CategoryWinnerOverride[]
  peopleChoiceVotes  PeopleChoiceVote[]

  @@unique([eventId, slug])
}

model Owner {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  phone           String
  email           String?
  publicName      String?
  publicNameOptIn Boolean        @default(false)
  waiverAccepted      Boolean        @default(false)
  ownerInviteSentAt   DateTime?
  ownerRainUpdateSentAt DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  vehicleEntries      VehicleEntry[]
}

model VehicleEntry {
  id                  String                   @id @default(cuid())
  eventId             String
  ownerId             String
  categoryId          String
  primaryPhotoId      String?                  @unique
  entryNumber         Int
  year                Int
  make                String
  model               String
  nickname            String?
  plateNumber         String?
  exteriorColor       String?
  internalNotes       String?
  buildStory          String?
  ownerAccessCode     String
  status              VehicleStatus            @default(REGISTERED)
  source              RegistrationSource       @default(ONSITE)
  checkedInAt         DateTime?
  registeredByStaffId String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  event               Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner               Owner                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category            Category                 @relation(fields: [categoryId], references: [id])
  primaryPhoto        VehiclePhoto?            @relation("VehiclePrimaryPhoto", fields: [primaryPhotoId], references: [id], onDelete: SetNull)
  registeredByStaff   StaffUser?               @relation("RegisteredBy", fields: [registeredByStaffId], references: [id])
  qrCard              QrCard?
  qrAuditLogs         QrAssignmentAuditLog[]   @relation("VehicleQrAudit")
  peopleChoiceVotes   PeopleChoiceVote[]
  judgeCategoryPicks  JudgeCategoryPick[]
  winnerOverrides     CategoryWinnerOverride[]
  photos              VehiclePhoto[]           @relation("VehiclePhotos")
  specialAwardVotes   SpecialAwardVote[]

  @@unique([eventId, entryNumber])
  @@unique([eventId, ownerAccessCode])
  @@index([eventId, status])
  @@index([eventId, categoryId])
  @@index([eventId, categoryId, status, entryNumber])
  @@index([ownerId])
}

enum PhotoModerationStatus {
  PENDING
  PROCESSING
  HUMAN_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum PhotoSource {
  STAFF
  OWNER
  VISITOR
}

model VehiclePhoto {
  id                  String                @id @default(cuid())
  vehicleEntryId      String
  url                 String?
  webUrl              String?
  mediumUrl           String?
  thumbUrl            String?
  storageKey          String?
  contentType         String?
  altText             String?
  sortOrder           Int                   @default(0)
  moderationStatus    PhotoModerationStatus @default(PENDING)
  moderationLabels    Json?
  uploadedBy          String?
  source              PhotoSource           @default(STAFF)
  processingStartedAt DateTime?
  processedAt         DateTime?
  createdAt           DateTime              @default(now())
  vehicleEntry        VehicleEntry          @relation("VehiclePhotos", fields: [vehicleEntryId], references: [id], onDelete: Cascade)
  primaryFor          VehicleEntry?         @relation("VehiclePrimaryPhoto")

  @@unique([vehicleEntryId, sortOrder])
  @@index([vehicleEntryId])
  @@index([vehicleEntryId, moderationStatus, sortOrder])
  @@index([moderationStatus])
  @@index([moderationStatus, processingStartedAt])
}

model RegistrationImportJob {
  id                  String                      @id @default(cuid())
  eventId             String
  createdByStaffId    String
  status              RegistrationImportJobStatus @default(PENDING)
  sourceFileName      String?
  totalItems          Int
  processingStartedAt DateTime?
  completedAt         DateTime?
  errorMessage        String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  event               Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdByStaff      StaffUser                   @relation(fields: [createdByStaffId], references: [id])
  items               RegistrationImportItem[]

  @@index([eventId, createdAt])
  @@index([status, processingStartedAt])
}

model RegistrationImportItem {
  id                  String                       @id @default(cuid())
  jobId               String
  entryNumber         Int
  rowData             Json
  categoryId          String
  ownerGroup          String
  vehicleEntryId      String?
  registrationStatus  RegistrationImportItemStatus @default(PENDING)
  photoStatus         RegistrationImportItemStatus @default(PENDING)
  registrationMessage String?
  photoMessage        String?
  processingStartedAt DateTime?
  completedAt         DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  job                 RegistrationImportJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, entryNumber])
  @@index([jobId, registrationStatus])
  @@index([jobId, photoStatus])
}

model PeopleChoiceVote {
  id                String       @id @default(cuid())
  eventId           String
  vehicleEntryId    String
  categoryId        String
  voterKey          String?
  ipAddress         String?
  userAgent         String?
  excludedAt        DateTime?
  excludedReason    String?
  excludedByStaffId String?
  createdAt         DateTime     @default(now())
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicleEntry      VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  excludedByStaff   StaffUser?   @relation("PeopleChoiceVoteExcludedBy", fields: [excludedByStaffId], references: [id])

  @@unique([eventId, categoryId, voterKey])
  @@index([eventId, vehicleEntryId])
  @@index([eventId, createdAt])
  @@index([eventId, excludedAt])
  @@index([eventId, ipAddress])
  @@index([eventId, voterKey])
}

model SpecialAward {
  id          String             @id @default(cuid())
  eventId     String
  name        String
  description String?
  active      Boolean            @default(true)
  sortOrder   Int                @default(0)
  ceremonyOrder Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes       SpecialAwardVote[]

  @@unique([eventId, name])
  @@index([eventId, active])
}

model SpecialAwardVote {
  id                String       @id @default(cuid())
  eventId           String
  specialAwardId    String
  vehicleEntryId    String
  voterKey          String?
  ipAddress         String?
  userAgent         String?
  excludedAt        DateTime?
  excludedReason    String?
  excludedByStaffId String?
  createdAt         DateTime     @default(now())
  event             Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  specialAward      SpecialAward @relation(fields: [specialAwardId], references: [id], onDelete: Cascade)
  vehicleEntry      VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)
  excludedByStaff   StaffUser?   @relation("SpecialAwardVoteExcludedBy", fields: [excludedByStaffId], references: [id])

  @@unique([eventId, specialAwardId, voterKey])
  @@index([eventId, specialAwardId])
  @@index([eventId, vehicleEntryId])
  @@index([eventId, createdAt])
  @@index([eventId, excludedAt])
  @@index([eventId, ipAddress])
  @@index([eventId, voterKey])
}

model JudgeCategoryPick {
  id             String       @id @default(cuid())
  eventId        String
  categoryId     String
  vehicleEntryId String
  judgeKey       String       @default("panel")
  rank           Int
  judgeName      String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vehicleEntry   VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)

  @@unique([eventId, categoryId, judgeKey, rank])
  @@unique([eventId, categoryId, judgeKey, vehicleEntryId])
  @@index([eventId, categoryId])
  @@index([eventId, vehicleEntryId])
}

model CategoryWinnerOverride {
  id               String       @id @default(cuid())
  eventId          String
  categoryId       String
  vehicleEntryId   String
  rank             Int
  reason           String?
  adminStaffUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  vehicleEntry     VehicleEntry @relation(fields: [vehicleEntryId], references: [id], onDelete: Cascade)
  adminStaffUser   StaffUser?   @relation(fields: [adminStaffUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, categoryId, rank])
  @@index([eventId, categoryId])
}

model QrCard {
  id             String                 @id @default(cuid())
  eventId        String
  visibleCode    String
  publicToken    String                 @unique
  status         QrCardStatus           @default(PRINTED)
  vehicleEntryId String?                @unique
  printedAt      DateTime?
  assignedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicleEntry   VehicleEntry?          @relation(fields: [vehicleEntryId], references: [id])
  auditLogs      QrAssignmentAuditLog[] @relation("QrCardAudit")

  @@unique([eventId, visibleCode])
  @@index([eventId, status])
}

model QrAssignmentAuditLog {
  id                     String        @id @default(cuid())
  eventId                String
  qrCardId               String
  vehicleEntryId         String?
  staffUserId            String
  action                 QrAuditAction
  reason                 String?
  previousVehicleEntryId String?
  createdAt              DateTime      @default(now())
  qrCard                 QrCard        @relation("QrCardAudit", fields: [qrCardId], references: [id], onDelete: Cascade)
  vehicleEntry           VehicleEntry? @relation("VehicleQrAudit", fields: [vehicleEntryId], references: [id])
  staffUser              StaffUser     @relation("QrAuditStaff", fields: [staffUserId], references: [id])

  @@index([eventId, qrCardId])
  @@index([eventId, vehicleEntryId])
}
